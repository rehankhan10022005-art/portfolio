rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Site content: anyone can read (the public portfolio needs this),
    // but only the one admin account can write. This is the real security
    // boundary — the client-side email checks in admin.html/admin-login.html
    // are just UX; this rule is what actually enforces it.
    match /content/site {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "megatech1978@gmail.com";
    }

    // Everything else: locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
